# 复制成同目录下的 secrets.toml，再填入你自己的 key。
# 本文件只有占位符，可以公开；真实的 secrets.toml 已被 .gitignore 排除，不要提交。
#
# 本地运行时（app.py / audit_agents.py）通过 st.secrets["DASHSCOPE_API_KEY"] 读取，
# 密钥只进服务端调用，不下发到浏览器、不出现在任何前端代码里。
# 线上版（site/ + functions/）不用这个文件：它在 Qoder Sites 的 Secret 配置里同名登记。

DASHSCOPE_API_KEY = "sk-替换成你自己的-key"

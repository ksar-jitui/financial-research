# ---- 虚拟环境与构建产物 ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ---- 编辑器与系统 ----
.idea/
.vscode/
.qoder/
.DS_Store
Thumbs.db
*.log

# ---- 密钥：进过 git 历史就只能吊销重发，删提交记录也不够 ----
# .streamlit/* 而不是 .streamlit/：git 无法在被排除的目录里重新纳入文件，
# 写成目录排除会让下面那份可公开的模板进不了仓库。
.env
.streamlit/*
!.streamlit/secrets.toml.example

# ---- 运行期数据：按股票代码建目录（年报 PDF、语调 txt、快照 PNG）与名录 CSV ----
# 第三方发布内容且体积已超 29M，不入库；但别退回成整目录排除 data/，
# 那样会把 data/ 重新变成源码位置时又挡掉代码。
data/[0-9][0-9][0-9][0-9][0-9][0-9]/
data/*.csv
data_storage/pdfs/*
data_storage/cache/*
data_storage/exports/*
!data_storage/**/.gitkeep

# ---- 普查缓存与跑批中间产物（脚本本体保留，缓存不保留）----
_dev/ref_rows.jsonl
_dev/ref_rows_v2.jsonl
_dev/ref_industry.json
_dev/ref_list*.json*
_dev/forward_rows.jsonl
_dev/validity_rows.jsonl
_dev/hi_top20.json
_dev/_*

# ---- 已被线上版取代的旧静态档案 ----
web/

# ---- Qoder Sites 部署描述文件：工具状态，含云端 ID 与 index.html 的 base64 ----
*.qoder.site

# ⚠ 这是早期分层原型（app/ agents/ core/ utils/ config/）的配置模板，当前产品不读它。
# 现在跑的两套运行时这样取密钥：
#   本地 Streamlit 版 → .streamlit/secrets.toml 里的 DASHSCOPE_API_KEY（见 secrets.toml.example）
#   线上版（site/ + functions/）→ Qoder Sites 的 Secret 配置，同名 DASHSCOPE_API_KEY
# 数据侧（东方财富、巨潮资讯）全程免 key。

# ===== 大模型 API =====
LLM_API_KEY=sk-your-api-key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# ===== 数据源 =====
CNINFO_MCP_URL=http://localhost:8000
EASTMONEY_MCP_URL=http://localhost:8001

# ===== 应用 =====
STREAMLIT_PORT=8501
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_PDF_DOWNLOADS=3
